# Binance API Keys (Produccion)
# Obtén tus keys en: https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Telegram Bot
# Crea un bot con @BotFather y obtén el token
# Obtén tu chat_id enviando un mensaje al bot y visitando https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Binance Testnet (gratis, sin KYC)
# Obtén tus keys en: https://testnet.binance.vision
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# SSL: activar solo si estas detras de proxy corporativo
DISABLE_SSL=false
